# Brewline environment. Copy to .env (compose reads it automatically) and adjust.
# These defaults work as-is for the local Docker Compose stack.

# --- Datastores ---
POSTGRES_USER=brewline
POSTGRES_PASSWORD=brewline
POSTGRES_DB=brewline
RABBITMQ_DEFAULT_USER=brewline
RABBITMQ_DEFAULT_PASS=brewline

# --- Payment simulator (ITER_03) ---
# Low defaults so normal traffic is healthy; dial PAYMENT_FAILURE_RATE up for the
# burn-rate alert demo.
PAYMENT_FAILURE_RATE=0.02
PAYMENT_LATENCY_MS=40

# --- Async fulfillment (ITER_02) ---
# Coupled to the gateway tail_sampling decision_wait (must stay well under 15s).
PREP_SECONDS=2

# --- ITER_04 experiment flags ---
BROKER_PROPAGATION=on    # experiment #1: set to "off" to fragment the trace
CARDINALITY_MODE=normal  # experiment #2: set to "high" to explode metric cardinality
