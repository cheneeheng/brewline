{
  "uid": "brewline-logs",
  "title": "Logs explore",
  "tags": ["brewline"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {"from": "now-15m", "to": "now"},
  "templating": {"list": []},
  "panels": [
    {
      "id": 1,
      "type": "logs",
      "title": "Brewline service logs (trace_id links to Jaeger)",
      "description": "The TraceID derived field on the Loki datasource links each line to its Jaeger trace.",
      "datasource": {"type": "loki", "uid": "loki"},
      "gridPos": {"h": 18, "w": 24, "x": 0, "y": 0},
      "options": {"showTime": true, "wrapLogMessage": true, "dedupStrategy": "none", "enableLogDetails": true},
      "targets": [
        {"refId": "A", "expr": "{service_namespace=\"brewline\"}"}
      ]
    }
  ]
}
