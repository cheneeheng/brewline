{
  "uid": "brewline-red",
  "title": "Service overview (RED)",
  "tags": ["brewline"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {"from": "now-15m", "to": "now"},
  "templating": {"list": []},
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request rate by service (req/s)",
      "description": "From OTel HTTP server instrumentation. Series name follows the pinned semconv version; if empty, see README note on http_server_* naming.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {"refId": "A", "expr": "sum by (service_name) (rate(http_server_request_duration_seconds_count[5m]))", "legendFormat": "{{service_name}}"}
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Error rate by service (5xx req/s)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {"refId": "A", "expr": "sum by (service_name) (rate(http_server_request_duration_seconds_count{http_response_status_code=~\"5..\"}[5m]))", "legendFormat": "{{service_name}}"}
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Order latency p50/p95/p99 (s)",
      "description": "From the explicit-bucket brewline_order_duration_seconds histogram.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 8},
      "targets": [
        {"refId": "A", "expr": "histogram_quantile(0.50, sum(rate(brewline_order_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p50"},
        {"refId": "B", "expr": "histogram_quantile(0.95, sum(rate(brewline_order_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p95"},
        {"refId": "C", "expr": "histogram_quantile(0.99, sum(rate(brewline_order_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p99"}
      ]
    }
  ]
}
